# ========================================================
# CODEVAS - CONFIGURATION TEMPLATE
# ========================================================
APP_ENV="development"

# Pilih Mode Database: 'local' (Laptop) atau 'server' (Synology NAS / Remote)
DB_MODE="local"

# 1. Database Laptop (Dev Lokal)
DATABASE_URL_LOCAL="postgresql://postgres:root@localhost:5432/codevas_db"

# 2. Database Server (Synology NAS / Remote)
DATABASE_URL_SERVER="postgresql://postgres:root@192.168.18.64:5432/codevas_db"

# Fallback Database URL
DATABASE_URL="postgresql://postgres:root@localhost:5432/codevas_db"

# Base URL Website
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret Key untuk JWT Session Tokens (Generate dengan: openssl rand -base64 32)
AUTH_SECRET="your-32-byte-base64-or-hex-secret-key-here"
